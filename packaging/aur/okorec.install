# The KMS helper may read the screen only with CAP_SYS_ADMIN (see the README).
post_install() {
  setcap cap_sys_admin+ep usr/bin/okorec-kms || echo "okorec: could not set the capability; run: setcap cap_sys_admin+ep /usr/bin/okorec-kms"
  echo "okorec: bind 'okorec save' and 'okorec record' to keys in your desktop's shortcut settings."
}

post_upgrade() {
  post_install
}
